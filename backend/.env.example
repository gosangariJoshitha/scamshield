# Database: replace every placeholder using Supabase → Connect → Session pooler → URI.
# Keep the real URI only in backend/.env; URL-encode reserved characters in its password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Security
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# AI/LLM Services (Milestone 5)
# auto prefers OpenRouter when configured, otherwise uses the existing Groq service.
LLM_PROVIDER=auto
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ScamShield
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=replace-with-model-enabled-for-your-account
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Application
DEVELOPMENT_MODE=true
# Comma-separated allowed frontend origins; local Vite localhost/127.0.0.1 origins are supported.
FRONTEND_URL=http://localhost:5173

# Jira Cloud (only automatically escalated ScamShield cases are sent to this project)
JIRA_ENABLED=false
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=jira-user@example.com
JIRA_API_TOKEN=replace-with-jira-api-token
JIRA_PROJECT_KEY=SCAM
# SendGrid
SENDGRID_API_KEY=replace-with-sendgrid-api-key
SENDGRID_SENDER_EMAIL=verified-sender@example.com

# Analysis resource limits (bytes, characters, pixels, and seconds)
ANALYSIS_MAX_UPLOAD_BYTES=52428800
ANALYSIS_MAX_IMAGE_BYTES=10485760
ANALYSIS_MAX_IMAGE_PIXELS=20000000
ANALYSIS_MAX_PDF_BYTES=20971520
ANALYSIS_MAX_PDF_PAGES=100
ANALYSIS_MAX_AUDIO_BYTES=26214400
ANALYSIS_MAX_AUDIO_SECONDS=600
ANALYSIS_MAX_TEXT_CHARS=20000
ANALYSIS_MAX_EMAIL_SUBJECT_CHARS=998
ANALYSIS_MAX_EMAIL_SENDER_CHARS=320
ANALYSIS_MAX_EMAIL_BODY_CHARS=20000
ANALYSIS_MAX_EXTRACTED_CHARS=30000

# Faster-Whisper transcription; model weights load on the first audio request.
# Supported values: tiny, base, small. CPU/int8 is the default configuration.
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# M9.6 Guardian analysis: in-memory rolling windows only; this endpoint is
# disconnected from the mobile app until verified CALL_AUDIO capture exists.
GUARDIAN_AI_MAX_SESSIONS=128
GUARDIAN_AI_SESSION_TTL_SECONDS=600
GUARDIAN_AI_MAX_WINDOW_CHARS=4000
GUARDIAN_AI_MAX_SEGMENTS=60
GUARDIAN_AI_MIN_NEW_CHARS=80
GUARDIAN_AI_MIN_NEW_WORDS=12
GUARDIAN_AI_MIN_SENTENCE_WORDS=8
GUARDIAN_AI_MIN_SIGNAL_WORDS=4
GUARDIAN_AI_ANALYSIS_INTERVAL_SECONDS=15

# Durable email/Jira outbox worker
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_POLL_SECONDS=10

# Authentication abuse controls (per client IP and account/challenge key)
AUTH_SIGNUP_LIMIT=5
AUTH_SIGNUP_WINDOW_SECONDS=900
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_VERIFY_LIMIT=10
AUTH_LOGIN_VERIFY_WINDOW_SECONDS=900
AUTH_FORGOT_PASSWORD_LIMIT=5
AUTH_FORGOT_PASSWORD_WINDOW_SECONDS=3600
AUTH_RESET_PASSWORD_LIMIT=10
AUTH_RESET_PASSWORD_WINDOW_SECONDS=900
AUTH_RESEND_VERIFICATION_LIMIT=3
AUTH_RESEND_VERIFICATION_WINDOW_SECONDS=900
